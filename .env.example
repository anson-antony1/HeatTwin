# Copy to .env (gitignored) and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional; default gemini-3.1-flash-lite (~$0.0015/call). Bigger: gemini-3.8-flash (~$0.006/call)
# GEMINI_MODEL=gemini-3.1-flash-lite
# Voice playback of approved answers (POST /voice/tts). Optional; without them the web uses the browser's speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=
# Live NWS forecast instead of the cached fixture (never used with ?demo=1)
# HEATTWIN_WEATHER=live

# Free voice decision layer (engine/decide.py, docs/VOICE.md): no key needed; these only move files.
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5     # another model needs `python -m validation.voice_decide` (its own calibration)
# FASTEMBED_CACHE_DIR=                       # default <repo>/.cache/fastembed (git-ignored)
# HEATTWIN_DECIDE_DOWNLOAD=1                 # let the engine fetch a missing model at runtime (default: only a cached model loads)
# HEATTWIN_DECIDE_BACKEND=lexical            # force the labelled lexical fallback
# Offline speech-to-text on a laptop (optional, never on a server): uv pip install faster-whisper; python -m engine.stt_local --fetch
# WHISPER_MODEL=base
# Optional laptop-only zero-shot NLI as a third guard vote (never on Render): python -m engine.nli_optional --fetch
# HEATTWIN_DECIDE_NLI=1
