# Copy to .env (gitignored) and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional; default gemini-3.1-flash-lite (~$0.0015/call). Bigger: gemini-3.8-flash (~$0.006/call)
# GEMINI_MODEL=gemini-3.1-flash-lite
# Voice playback of approved answers (POST /voice/tts). Optional; without them the web uses the browser's speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=
# Live NWS forecast instead of the cached fixture (never used with ?demo=1)
# HEATTWIN_WEATHER=live
