{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "engine",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["engine.api:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
